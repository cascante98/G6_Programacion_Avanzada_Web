@model TicketEvents.ViewModels.EventoDetalleViewModel
@{
    var evento = Model.Evento;
    ViewBag.Title = evento.Nombre;
    var imagenes = evento.Imagenes == null ? new List<TicketEvents.Entities.Models.Imagen>() : evento.Imagenes.OrderBy(i => i.ImagenId).ToList();
}

<section class="page-heading">
    <span class="eyebrow">@evento.Categoria &middot; @evento.Codigo</span>
    <h1>@evento.Nombre</h1>
    @if (!evento.Estado)
    {
        <span class="badge bg-secondary">Evento inactivo (solo visible para administradores)</span>
    }
</section>

<div class="row g-4">
    <div class="col-lg-7">
        @if (imagenes.Any())
        {
            <div id="galeriaEvento" class="carousel slide panel-card event-gallery" data-bs-ride="carousel">
                <div class="carousel-indicators">
                    @for (var i = 0; i < imagenes.Count; i++)
                    {
                        <button type="button" data-bs-target="#galeriaEvento" data-bs-slide-to="@i" class="@(i == 0 ? "active" : "")"
                                aria-label="Imagen @(i + 1)" @(i == 0 ? "aria-current=true" : "")></button>
                    }
                </div>
                <div class="carousel-inner">
                    @for (var i = 0; i < imagenes.Count; i++)
                    {
                        <div class="carousel-item @(i == 0 ? "active" : "")">
                            <img src="@Url.Action("Imagen", "Evento", new { id = imagenes[i].ImagenId })" class="d-block w-100" alt="Imagen @(i + 1) de @evento.Nombre" />
                        </div>
                    }
                </div>
                <button class="carousel-control-prev" type="button" data-bs-target="#galeriaEvento" data-bs-slide="prev">
                    <span class="carousel-control-prev-icon" aria-hidden="true"></span><span class="visually-hidden">Anterior</span>
                </button>
                <button class="carousel-control-next" type="button" data-bs-target="#galeriaEvento" data-bs-slide="next">
                    <span class="carousel-control-next-icon" aria-hidden="true"></span><span class="visually-hidden">Siguiente</span>
                </button>
            </div>
        }
        <div class="panel-card p-4 mt-4">
            <h2 class="h5">Descripci&oacute;n</h2>
            <p class="mb-0">@evento.Descripcion</p>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="panel-card p-4 d-flex flex-column">
            <div class="event-meta mt-0">
                <p><span>Fecha y hora</span><strong>@evento.FechaHora.ToString("dddd dd/MM/yyyy HH:mm")</strong></p>
                <p><span>Lugar</span><strong>@evento.Ubicacion</strong></p>
                <p><span>Disponibles</span><strong>@evento.EntradasDisponibles de @evento.AforoTotal</strong></p>
                <p>
                    <span>Calificaci&oacute;n</span>
                    <strong>@(Model.PromedioCalificacion.HasValue ? Model.PromedioCalificacion.Value.ToString("0.0") + " / 5 (" + Model.Resenas.Count + ")" : "Sin reseñas aún")</strong>
                </p>
            </div>
            <div class="event-price">@evento.Precio.ToString("C")</div>
            @Html.Partial("_AgregarCarrito", evento)
        </div>
    </div>
</div>

<section class="mt-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h2 class="h4 mb-0">Rese&ntilde;as de asistentes</h2>
        @if (User.IsInRole("Asociado"))
        {
            <a class="btn btn-sm btn-outline-primary" href="@Url.Action("Crear", "Resenas", new { eventoId = evento.EventoId })">Calificar este evento</a>
        }
    </div>
    @if (!Model.Resenas.Any())
    {
        <div class="empty-state py-4"><p class="mb-0">Todav&iacute;a no hay rese&ntilde;as aprobadas para este evento.</p></div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in Model.Resenas)
            {
                <div class="col-md-6">
                    <article class="panel-card p-3 h-100">
                        <div class="d-flex justify-content-between">
                            <strong>@(r.Usuario == null ? "Asociado" : r.Usuario.Nombre)</strong>
                            <span class="stars" aria-label="@r.Calificacion de 5">@(new string('★', r.Calificacion))@(new string('☆', 5 - r.Calificacion))</span>
                        </div>
                        <small class="text-muted">@r.FechaCreacion.ToString("dd/MM/yyyy")</small>
                        <p class="mb-0 mt-2">@r.Comentario</p>
                    </article>
                </div>
            }
        </div>
    }
</section>

<p class="mt-4">@Html.ActionLink("← Volver a la cartelera", "Index", null, new { @class = "btn btn-outline-secondary" })</p>
