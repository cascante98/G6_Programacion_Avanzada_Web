@model TicketEvents.Entities.Models.Evento
@{
    ViewBag.Title = "Crear evento";
}

<section class="page-heading">
    <span class="eyebrow">Administraci&oacute;n de eventos</span>
    <h1>Crear evento</h1>
    <p>Las entradas disponibles se inicializan con el aforo total.</p>
</section>

@using (Html.BeginForm("Create", "EventosAdmin", FormMethod.Post, new { enctype = "multipart/form-data", id = "form-evento" }))
{
    @Html.AntiForgeryToken()
    <div class="panel-card p-4">
        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger" })
        @Html.Partial("_EventoCampos", Model)

        <div class="mt-3">
            <label class="form-label" for="imagenesSubidas">Im&aacute;genes del evento (m&iacute;nimo 3)</label>
            <input type="file" name="imagenesSubidas" id="imagenesSubidas" multiple accept="image/jpeg,image/png,image/gif" class="form-control" />
            <div class="form-text">JPG, PNG o GIF de hasta 2 MB cada una. Se guardan en la base de datos.</div>
            <div id="vista-previa" class="admin-image-grid"></div>
        </div>

        <div class="mt-4 d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span> Crear evento
            </button>
            @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-outline-secondary" })
        </div>
    </div>
}

@section scripts {
    @Html.Partial("_EventoFormScripts")
}
