@model IEnumerable<TicketEvents.Entities.Models.Evento>
@{
    ViewBag.Title = "Administración de eventos";
}

<section class="page-heading d-flex flex-wrap justify-content-between align-items-end gap-3">
    <div>
        <span class="eyebrow">Administraci&oacute;n</span>
        <h1>Eventos</h1>
    </div>
    @Html.ActionLink("+ Crear evento", "Create", null, new { @class = "btn btn-primary" })
</section>

@if (TempData["Mensaje"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">@TempData["Mensaje"]<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button></div>
}

<div class="panel-card table-responsive">
    <table class="table align-middle mb-0">
        <thead>
            <tr><th>C&oacute;digo</th><th>Nombre</th><th>Categor&iacute;a</th><th>Fecha</th><th>Precio</th><th>Disponibles</th><th>Estado</th><th class="text-end">Acciones</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.Codigo</code></td>
                    <td><a href="@Url.Action("Detalle", "Evento", new { id = item.EventoId })">@item.Nombre</a></td>
                    <td>@item.Categoria</td>
                    <td>@item.FechaHora.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@item.Precio.ToString("C")</td>
                    <td>@item.EntradasDisponibles / @item.AforoTotal</td>
                    <td>
                        @if (item.Estado)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">Inactivo</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        @Html.ActionLink("Editar", "Edit", new { id = item.EventoId }, new { @class = "btn btn-sm btn-outline-primary" })
                        @Html.ActionLink("Eliminar", "Delete", new { id = item.EventoId }, new { @class = "btn btn-sm btn-outline-danger" })
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
