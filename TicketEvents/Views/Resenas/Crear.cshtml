@model IEnumerable<TicketEvents.Entities.Models.Evento>
@{
    ViewBag.Title = "Calificar evento";
    var seleccionado = ViewBag.EventoSeleccionado as int?;
}

<section class="page-heading">
    <span class="eyebrow">Comparte tu experiencia</span>
    <h1>Calificar un evento</h1>
    <p>Solo puedes rese&ntilde;ar eventos para los que compraste entradas. Tu rese&ntilde;a quedar&aacute; pendiente hasta que un administrador la apruebe.</p>
</section>

@if (!Model.Any())
{
    <div class="empty-state">
        <div class="empty-icon">★</div>
        <h2>A&uacute;n no tienes eventos para calificar</h2>
        <p>Cuando compres entradas para un evento podr&aacute;s dejar tu rese&ntilde;a aqu&iacute;.</p>
        @Html.ActionLink("Ir a la cartelera", "Index", "Evento", null, new { @class = "btn btn-primary" })
    </div>
}
else
{
    <div class="panel-card p-4 review-form-card">
        <form id="resena-form" novalidate>
            <div class="mb-3">
                <label for="EventoId" class="form-label">Evento</label>
                <select id="EventoId" class="form-select" required>
                    <option value="">Selecciona un evento</option>
                    @foreach (var evento in Model)
                    {
                        <option value="@evento.EventoId" @(seleccionado == evento.EventoId ? "selected" : "")>@evento.Nombre (@evento.FechaHora.ToString("dd/MM/yyyy"))</option>
                    }
                </select>
                <div class="invalid-feedback">Selecciona un evento.</div>
            </div>
            <div class="mb-3">
                <label for="Calificacion" class="form-label">Calificaci&oacute;n</label>
                <select id="Calificacion" class="form-select" required>
                    <option value="">Selecciona una calificaci&oacute;n</option>
                    <option value="5">★★★★★ 5 - Excelente</option>
                    <option value="4">★★★★ 4 - Muy buena</option>
                    <option value="3">★★★ 3 - Buena</option>
                    <option value="2">★★ 2 - Regular</option>
                    <option value="1">★ 1 - Mala</option>
                </select>
                <div class="invalid-feedback">Selecciona una calificaci&oacute;n.</div>
            </div>
            <div class="mb-3">
                <label for="Comentario" class="form-label">Comentario</label>
                <textarea id="Comentario" class="form-control" rows="5" minlength="5" maxlength="500" required placeholder="Cuéntanos cómo fue tu experiencia"></textarea>
                <div class="invalid-feedback">Escribe un comentario de al menos 5 caracteres.</div>
                <div class="form-text"><span id="contador">0</span>/500 caracteres.</div>
            </div>
            <button id="enviar-resena" type="submit" class="btn btn-primary">
                <span class="spinner-border spinner-border-sm d-none" role="status" aria-hidden="true"></span> Enviar rese&ntilde;a
            </button>
        </form>
    </div>
}

@section scripts {
    <script>
        $(function () {
            $('#Comentario').on('input', function () { $('#contador').text(this.value.length); });

            // POST api/resenas
            $('#resena-form').on('submit', function (e) {
                e.preventDefault();
                var form = this;
                if (!form.checkValidity()) { form.classList.add('was-validated'); return; }

                var $b = $('#enviar-resena');
                TE.cargando($b, true);
                $.ajax({
                    url: TE.api('resenas'),
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ EventoId: Number($('#EventoId').val()), Calificacion: Number($('#Calificacion').val()), Comentario: $('#Comentario').val() })
                }).done(function (r) {
                    TE.toast(r.mensaje, 'success');
                    form.reset(); form.classList.remove('was-validated'); $('#contador').text(0);
                }).fail(function (xhr) {
                    TE.toast(TE.mensajeError(xhr, 'No fue posible enviar la reseña.'), 'danger');
                }).always(function () { TE.cargando($b, false); });
            });
        });
    </script>
}
